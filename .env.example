# Copy to .env in the repository root. All three apps read this one file.

# ── Supabase (accounts + database) ───────────────────────────────────────────
# Project URL and the two API keys: Dashboard -> Project Settings -> API Keys.
#   publishable key (sb_publishable_...)  safe for browsers; the web app uses it to sign people in
#   secret key (sb_secret_...)            SERVER ONLY; the API uses it to read/write the database. Never expose it.
# Run supabase/migrations/0001_init.sql once in the SQL Editor to create the tables, and turn on
# Authentication -> Sign In / Providers -> Email -> "Confirm email" (the free demo relies on verified addresses).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Optional. Defaults to <SUPABASE_URL>/auth/v1/.well-known/jwks.json, which is what Supabase publishes.
# SUPABASE_JWKS_URL=

# ── LiveKit ──────────────────────────────────────────────────────────────────
# Local dev server (docker compose up -d):   ws://localhost:7880  devkey / secret
# LiveKit Cloud:                              wss://<project>.livekit.cloud  + keys from the dashboard
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# Optional: keys from a LiveKit Cloud project, used ONLY for the LiveKit Inference gateway (STT/TTS/LLM models).
# This lets the room server above stay local while the models run on Cloud. Falls back to LIVEKIT_API_KEY / SECRET.
# LIVEKIT_INFERENCE_API_KEY=
# LIVEKIT_INFERENCE_API_SECRET=

# ── API ──────────────────────────────────────────────────────────────────────
API_PORT=4000
# Where the agent worker and the Next.js dev proxy reach the API
API_URL=http://localhost:4000
# Browser origin(s) of the web app, for CORS. Several are allowed, comma-separated, e.g.
#   WEB_ORIGIN=https://app.example.com,https://my-app.vercel.app
WEB_ORIGIN=http://localhost:3000
# Web app only (set on the web host, e.g. Vercel; leave unset locally): the API's public address. When set, the browser
# calls the API directly instead of through the Next.js /api proxy.
# NEXT_PUBLIC_API_URL=https://your-api.onrender.com
# Reverse proxies in front of the API: "loopback" for local development, or the number of hops on a host. Measure it
# after deploying with GET /internal/whoami (see RUNBOOK); too high lets callers fake their address.
# TRUST_PROXY=1
# Shared secret between the API and the agent worker. Generate with: openssl rand -hex 32
INTERNAL_API_KEY=replace-with-a-long-random-string
# Encrypts candidates' own provider keys at rest (AES-256-GCM): 32 random bytes, base64.  openssl rand -base64 32
# BACK THIS UP. If it is lost, every saved key becomes unreadable. Required in production.
KEY_ENCRYPTION_SECRET=

# ── Free demo + bring-your-own-key ───────────────────────────────────────────
# Every new account gets ONE free demo interview on the platform's models (the STT/LLM/TTS_PROVIDER settings below).
# After that, people add their own provider keys in Settings and run full interviews on those.
DEMO_ENABLED=true
DEMO_MAX_MINUTES=8
# Demo interviews that actually ran, per UTC day, across everyone (a spend guard; 0 = no limit) and per person.
DEMO_DAILY_LIMIT=30
DEMO_ATTEMPTS_PER_DAY=3

# ── Agent ────────────────────────────────────────────────────────────────────
# Must match the dispatch name used by the API when it mints tokens.
AGENT_NAME=ai-interviewer
# Length of a full (own-keys) interview. The agent starts wrapping up ~3 min before this and hard-stops 2 min after.
INTERVIEW_MAX_MINUTES=25
# How long the interviewer holds a disconnected candidate's place (refresh, Wi-Fi drop) before ending and saving.
REJOIN_GRACE_SECONDS=120
# End the interview as "no response" if the candidate says nothing at all for this long.
NO_RESPONSE_SECONDS=180
# Minimum gap between join tokens for one interview (stops two tabs racing for the same seat).
TOKEN_REISSUE_SECONDS=10

# ── Platform models (used for the free demo; candidates' own interviews use their own keys) ──
# MODEL_PROVIDER=plugins  -> OpenAI (LLM + TTS) and Deepgram/OpenAI (STT) using your own keys. Works with any LiveKit server.
# MODEL_PROVIDER=inference -> LiveKit Inference gateway. No provider keys, but requires LiveKit Cloud.
MODEL_PROVIDER=plugins

# Optional per-stage override of MODEL_PROVIDER. Unset, each stage follows MODEL_PROVIDER.
#   STT_PROVIDER: inference | deepgram | openai | groq | google
#   LLM_PROVIDER: inference | openai | groq | google | openrouter
#   TTS_PROVIDER: inference | openai | google
# Example: LiveKit Inference for STT/TTS (via LIVEKIT_INFERENCE_* above) and Groq for the LLM:
# STT_PROVIDER=inference
# TTS_PROVIDER=inference
# LLM_PROVIDER=groq
# Example: all Gemini (run `npm run probe:gemini` first):
# STT_PROVIDER=google
# LLM_PROVIDER=google
# TTS_PROVIDER=google

# plugins mode
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
OPENAI_LLM_MODEL=gpt-4.1-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy

# groq (STT_PROVIDER=groq and/or LLM_PROVIDER=groq)
GROQ_API_KEY=
GROQ_LLM_MODEL=qwen/qwen3.8-27b
GROQ_STT_MODEL=whisper-large-v3-turbo

# openrouter (LLM only). With a key set, it is also the demo's automatic backup when the main model fails
# (for example a Groq rate limit). LLM_FALLBACK_PROVIDER=none turns the backup off.
OPENROUTER_API_KEY=
OPENROUTER_LLM_MODEL=openai/gpt-4o-mini
# LLM_FALLBACK_PROVIDER=openrouter

# google (any *_PROVIDER=google). The free tier has low limits and Google may use free-tier prompts to improve its
# products; enable billing on the key's project for real traffic.
GOOGLE_API_KEY=
GEMINI_LLM_MODEL=gemini-3.5-flash
GEMINI_STT_MODEL=gemini-3.5-transcribe-live
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_VOICE=Kore

# inference mode
INFERENCE_STT_MODEL=deepgram/nova-3
INFERENCE_LLM_MODEL=openai/gpt-4.1-mini
INFERENCE_TTS_MODEL=cartesia/sonic-3
INFERENCE_TTS_VOICE=9626c31c-bec5-4cca-baa8-f8ba9e84c8bc
